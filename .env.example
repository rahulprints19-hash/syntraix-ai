# Syntrix AI Next.js SaaS environment
# Copy frontend/.env.example to frontend/.env.local for local development.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

OPENAI_API_KEY=sk-your-openai-key
OPENAI_DEFAULT_MODEL=gpt-4.1-mini

NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_public_key
RAZORPAY_KEY_ID=rzp_test_your_public_key
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

RAZORPAY_PLAN_PRO_MONTHLY=plan_xxx
RAZORPAY_PLAN_PRO_YEARLY=plan_xxx
RAZORPAY_PLAN_PLUS_MONTHLY=plan_xxx
RAZORPAY_PLAN_PLUS_YEARLY=plan_xxx
RAZORPAY_PLAN_ULTRA_MONTHLY=plan_xxx
RAZORPAY_PLAN_ULTRA_YEARLY=plan_xxx
